generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  COORDINATOR
  HOD
  SUPERVISOR
  STUDENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  CANCELLED
  RESUBMITTED
}

enum InternshipStatus {
  PENDING
  PLACED
  COMPLETED
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum PostType {
  ANNOUNCEMENT
  OPPORTUNITY
  EXPERIENCE
  GENERAL_UPDATE
}

enum PostVisibility {
  PUBLIC
  UNIVERSITY
  COMPANY
  ROLE_SPECIFIC
}

enum FileType {
  VERIFICATION_DOC
  WEEKLY_PRESENTATION
  PLAN_ATTACHMENT
  PROPOSAL_ATTACHMENT
  COMPANY_STAMP
  FINAL_REPORT
  COMMON_FEED_IMAGE
  COMMON_FEED_DOCUMENT
}

model User {
  id                          Int             @id @default(autoincrement())
  full_name                   String
  email                       String          @unique
  password_hash               String
  role                        Role
  created_at                  DateTime        @default(now())
  updated_at                  DateTime        @updatedAt
  verification_status         ApprovalStatus  @default(PENDING)
  reset_password_expires      DateTime?
  reset_password_token        String?
  verification_token          String?         @unique
  verification_token_expiry   DateTime?
  verification_document       String?
  /// COORDINATOR/SUPERVISOR/HOD: Pending until admin (coord./sup.) or coordinator (HOD) approves. STUDENT/ADMIN default APPROVED.
  institution_access_approval ApprovalStatus  @default(APPROVED)
  must_change_password        Boolean         @default(false)
  aiChatMessages              AiChatMessage[]
  announcements               Announcement[]
  receivedMessages            ChatMessage[]   @relation("ReceivedMessages")
  sentMessages                ChatMessage[]   @relation("SentMessages")
  commonPosts                 CommonPost[]
  coordinatorProfile          Coordinator?
  hodProfile                  HodProfile?
  notifications               Notification[]
  postComments                PostComment[]
  postLikes                   PostLike[]
  postReports                 PostReport[]
  postViews                   PostView[]
  studentProfile              Student?
  supervisorProfile           Supervisor?
  activityLogs                ActivityLog[]
  auditLogs                   AuditLog[]
}

/// Daily activity counts for contribution heatmap (login, submissions, etc.).
model ActivityLog {
  id     Int      @id @default(autoincrement())
  userId Int
  date   DateTime @db.Date
  count  Int      @default(0)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("activity_logs")
}

/// Persisted AI assistant chat (one thread per user; chronological messages)
model AiChatMessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  speaker   String
  content   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model University {
  id               Int                  @id @default(autoincrement())
  name             String
  official_email   String               @unique
  address          String?
  verification_doc String?
  approval_status  ApprovalStatus       @default(PENDING)
  created_at       DateTime             @default(now())
  rejection_reason String?
  coordinators     Coordinator[]
  hods             HodProfile[]
  students         Student[]
  proposalsSent    InternshipProposal[]
  reportsReceived  Report[]             @relation("ReportToUniversity")
  config           UniversityConfig?
}

model Company {
  id                Int                    @id @default(autoincrement())
  name              String
  official_email    String                 @unique
  address           String?
  stamp_image_url   String?
  verification_doc  String?
  approval_status   ApprovalStatus         @default(PENDING)
  created_at        DateTime               @default(now())
  rejection_reason  String?
  assignments       InternshipAssignment[]
  proposalsReceived InternshipProposal[]
  projects          Project[]
  supervisors       Supervisor[]
  teams             Team[]
}

model Coordinator {
  id                      Int         @id @default(autoincrement())
  userId                  Int         @unique
  universityId            Int?        @unique
  phone_number            String?
  /// Stored during registration; used to create the University record upon admin approval
  pending_university_name String?
  university              University? @relation(fields: [universityId], references: [id])
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Maps to the `Hod` table (see migration add_hod_module). Prisma model name kept as HodProfile for stable client API.
model HodProfile {
  id           Int        @id @default(autoincrement())
  userId       Int        @unique
  universityId Int
  department   String
  phone_number String?
  university   University @relation(fields: [universityId], references: [id])
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  students     Student[]

  @@index([universityId, department])
  @@map("Hod")
}

model Supervisor {
  id            Int               @id @default(autoincrement())
  userId        Int               @unique
  companyId     Int
  phone_number  String?
  evaluations   FinalEvaluation[]
  company       Company           @relation(fields: [companyId], references: [id])
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyReports WeeklyReport[]
}

model Student {
  id                  Int                    @id @default(autoincrement())
  userId              Int                    @unique
  universityId        Int
  registration_type   String
  internship_status   InternshipStatus       @default(PENDING)
  created_at          DateTime               @default(now())
  department          String?
  studentId           String?
  /// HOD must approve self-registered students before full access (coordinator-registered students are APPROVED).
  hod_approval_status ApprovalStatus         @default(PENDING)
  hodId               Int?
  /// Optional flag set by HoD: 'LOW_PERFORMANCE' | 'INACTIVE'
  flag_type           String?
  flag_note           String?
  finalEvaluation     FinalEvaluation?
  assignments         InternshipAssignment[]
  proposals           InternshipProposal[]
  teamProposals       ProposalTeamMember[]
  finalReport         Report?
  hod                 HodProfile?            @relation(fields: [hodId], references: [id])
  university          University             @relation(fields: [universityId], references: [id])
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentProjects     StudentProject[]
  studentTeams        StudentTeam[]
  weeklyPlans         WeeklyPlan[]
  weeklyReports       WeeklyReport[]
}

model InternshipProposal {
  id                      Int                  @id @default(autoincrement())
  universityId            Int
  companyId               Int
  studentId               Int
  status                  ApprovalStatus       @default(PENDING)
  proposal_type           String
  submitted_at            DateTime             @default(now())
  expected_duration_weeks Int?
  expected_outcomes       String?
  responded_at            DateTime?
  /// JSON array of attachment objects: [{ url, name, type, size, uploadedAt }]
  attachments             Json                 @default("[]")
  /// Additional team members (empty for INDIVIDUAL proposals)
  teamMembers             ProposalTeamMember[]
  university              University           @relation(fields: [universityId], references: [id])
  company                 Company              @relation(fields: [companyId], references: [id])
  student                 Student              @relation(fields: [studentId], references: [id])

  @@index([studentId, companyId, status])
}

/// Join table for team proposal members (excludes the lead student already in studentId).
model ProposalTeamMember {
  id         Int                @id @default(autoincrement())
  proposalId Int
  studentId  Int
  proposal   InternshipProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student    Student            @relation(fields: [studentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([proposalId, studentId])
  @@index([proposalId])
  @@index([studentId])
}

model InternshipAssignment {
  id           Int              @id @default(autoincrement())
  studentId    Int
  companyId    Int
  start_date   DateTime
  end_date     DateTime?
  status       AssignmentStatus @default(ACTIVE)
  project_name String?
  company      Company          @relation(fields: [companyId], references: [id])
  student      Student          @relation(fields: [studentId], references: [id])
}

model WeeklyPlan {
  id               Int                       @id @default(autoincrement())
  studentId        Int
  week_number      Int
  plan_description String
  status           ApprovalStatus            @default(PENDING)
  submitted_at     DateTime                  @default(now())
  feedback         String?
  reviewed_at      DateTime?
  version          Int                       @default(1)
  /// JSON array of attachment objects: [{ url, name, type, size, uploadedAt }]
  attachments      Json                      @default("[]")
  student          Student                   @relation(fields: [studentId], references: [id])
  presentation     WeeklyPresentation?
  weeklyReports    WeeklyReport[]
  daySubmissions   WeeklyPlanDaySubmission[]
}

/// One row per calendar day the student marked as submitted for that approved weekly plan (daily check-in).
model WeeklyPlanDaySubmission {
  id           Int        @id @default(autoincrement())
  weeklyPlanId Int
  workDate     DateTime   @db.Date
  notes        String?
  submittedAt  DateTime   @default(now())
  weeklyPlan   WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)

  @@unique([weeklyPlanId, workDate])
  @@index([weeklyPlanId])
}

model WeeklyPresentation {
  id           Int        @id @default(autoincrement())
  weeklyPlanId Int        @unique
  file_url     String
  uploaded_at  DateTime   @default(now())
  weeklyPlan   WeeklyPlan @relation(fields: [weeklyPlanId], references: [id])
}

model WeeklyReport {
  id               Int              @id @default(autoincrement())
  studentId        Int
  supervisorId     Int
  remarks          String?
  submitted_at     DateTime         @default(now())
  weeklyPlanId     Int?             @unique
  attendanceStatus AttendanceStatus @default(PRESENT)
  execution_status String?
  student          Student          @relation(fields: [studentId], references: [id])
  supervisor       Supervisor       @relation(fields: [supervisorId], references: [id])
  weeklyPlan       WeeklyPlan?      @relation(fields: [weeklyPlanId], references: [id])
}

model FinalEvaluation {
  id               Int        @id @default(autoincrement())
  studentId        Int        @unique
  supervisorId     Int
  technical_score  Decimal    @db.Decimal(5, 2)
  soft_skill_score Decimal    @db.Decimal(5, 2)
  comments         String?
  evaluated_at     DateTime   @default(now())
  student          Student    @relation(fields: [studentId], references: [id])
  supervisor       Supervisor @relation(fields: [supervisorId], references: [id])
}

model Report {
  id                 Int         @id @default(autoincrement())
  studentId          Int         @unique
  pdf_url            String
  stamped            Boolean     @default(false)
  generated_at       DateTime    @default(now())
  sent_at            DateTime?
  locked             Boolean     @default(false)
  sentToUniversityId Int?
  sentToUniversity   University? @relation("ReportToUniversity", fields: [sentToUniversityId], references: [id])
  student            Student     @relation(fields: [studentId], references: [id])
}

model Team {
  id           Int           @id @default(autoincrement())
  name         String
  companyId    Int
  supervisorId Int?
  projectId    Int?
  created_at   DateTime      @default(now())
  deleted_at   DateTime?
  members      StudentTeam[]
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id])
}

model StudentTeam {
  studentId Int
  teamId    Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([studentId, teamId])
}

model Project {
  id             Int              @id @default(autoincrement())
  name           String
  companyId      Int
  supervisorId   Int?
  description    String?
  capacity       Int              @default(0)
  requiredSkills String[]         @default([])
  created_at     DateTime         @default(now())
  deleted_at     DateTime?
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  students       StudentProject[]
  teams          Team[]
}

model StudentProject {
  studentId Int
  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([studentId, projectId])
}

model Announcement {
  id         Int      @id @default(autoincrement())
  authorId   Int
  title      String
  content    String
  created_at DateTime @default(now())
  author     User     @relation(fields: [authorId], references: [id])
}

model CommonPost {
  id                 Int            @id @default(autoincrement())
  authorId           Int
  postType           PostType       @default(GENERAL_UPDATE)
  visibility         PostVisibility @default(PUBLIC)
  title              String
  content            String
  imageUrls          String[]       @default([])
  documentUrls       String[]       @default([])
  targetUniversityId Int?
  targetCompanyId    Int?
  targetRoles        Role[]         @default([])
  viewCount          Int            @default(0)
  likeCount          Int            @default(0)
  commentCount       Int            @default(0)
  isModerated        Boolean        @default(false)
  isPinned           Boolean        @default(false)
  isArchived         Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  author             User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments           PostComment[]
  likes              PostLike[]
  reports            PostReport[]
  views              PostView[]

  @@index([authorId, createdAt])
  @@index([postType, createdAt])
  @@index([visibility, createdAt])
  @@index([isPinned, isArchived, createdAt])
}

model PostComment {
  id        Int           @id @default(autoincrement())
  postId    Int
  authorId  Int
  content   String
  parentId  Int?
  isEdited  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    PostComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PostComment[] @relation("CommentReplies")
  post      CommonPost    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}

model PostLike {
  id        Int        @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime   @default(now())
  post      CommonPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model PostView {
  id       Int        @id @default(autoincrement())
  postId   Int
  userId   Int
  viewedAt DateTime   @default(now())
  post     CommonPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model PostReport {
  id          Int        @id @default(autoincrement())
  postId      Int
  reporterId  Int
  reason      String
  description String?
  status      String     @default("PENDING")
  createdAt   DateTime   @default(now())
  reviewedAt  DateTime?
  post        CommonPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter    User       @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([reporterId])
  @@index([status])
}

model Notification {
  id          Int      @id @default(autoincrement())
  recipientId Int
  message     String
  is_read     Boolean  @default(false)
  created_at  DateTime @default(now())
  recipient   User     @relation(fields: [recipientId], references: [id])
}

model File {
  id             String   @id @default(uuid())
  userId         Int?
  organizationId Int?
  type           FileType
  url            String
  publicId       String
  filename       String
  mimeType       String
  size           Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, type])
  @@index([organizationId, type])
  @@map("files")
}

/// Key-value store for platform-wide configuration set by admins.
model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Admin action audit trail.
model AuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int
  action    String
  targetId  Int?
  details   String?
  timestamp DateTime @default(now())
  admin     User     @relation(fields: [adminId], references: [id])

  @@index([adminId, timestamp])
}

/// Per-university registration override.
/// studentRegistrationEnabled = null → use global SystemConfig setting.
/// studentRegistrationEnabled = true/false → override global setting.
model UniversityConfig {
  id                         Int        @id @default(autoincrement())
  universityId               Int        @unique
  studentRegistrationEnabled Boolean?
  updatedAt                  DateTime   @updatedAt
  university                 University @relation(fields: [universityId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  content    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId, created_at])
  @@index([receiverId, is_read])
}
